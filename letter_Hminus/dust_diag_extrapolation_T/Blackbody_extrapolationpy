# Blackbody extrapolation at 0.447 mm 

from units_astro import *
from numpy import exp
import numpy as np

# this will receive an array of Temperatures and return the plank function for each temperature
def plank(T, nu):    
    x=h*nu/(kb*T)
    mask1 = x < 1e-3  # low frequency limit
    mask2 = x > 1e1   # high frequency limit
    result = np.zeros_like(x) #
    result[mask1] = 2*nu**2/c**2*kb*T[mask1]
    result[mask2] = 2*h*nu**3/c**2*exp(-x[mask2])
    mask3 = ~(mask1 | mask2)  # intermediate values
    result[mask3] = 2*h*nu**3/c**2/(exp(x[mask3])-1)
    return result*10**26  # to convert to mJy/sr

nu=671e9 # frequency in Hz for 0.447 mm
flux=0.340 # flux in mJy

nu_test=145e9 # frequency in Hz for 2.07 mm Band 4
flux_test=0.0214

T_arr=np.array([22, 27, 50]) # array of temperatures in K

I_nu_arr=plank(T_arr, nu) # array of intensities in mJy/sr
print(f'Intensities at {nu/1e9:.2f} GHz: {I_nu_arr} mJy/sr')

solid_angle=flux/I_nu_arr[0] # sr
print(f'Solid angle at {nu/1e9:.2f} GHz: {solid_angle} sr')
# and the solid angles at 27 and 50 scale as 22/T
solid_angle_arr=solid_angle*22/T_arr # sr
print(f'Solid angles at {nu/1e9:.2f} GHz: {solid_angle_arr} sr')

# print the fluxes at 27 and 50 K using the solid angles
fluxes_arr=I_nu_arr*solid_angle_arr # fluxes in mJy
print(f'Fluxes at {nu/1e9:.2f} GHz: {fluxes_arr} mJy')

# And the sigmas off for each temperature
Band9_flux=0.143 # mJy
Sigma9=0.115

sigmas_off_arr=(fluxes_arr-Band9_flux)/Sigma9
print(f'Sigmas off at {nu/1e9:.2f} GHz: {sigmas_off_arr} sigmas')

# the other case just print sigma_value
sigma_value=fluxes_arr/Sigma9
print(f'Sigma value at {nu/1e9:.2f} GHz: {sigma_value} sigmas')


